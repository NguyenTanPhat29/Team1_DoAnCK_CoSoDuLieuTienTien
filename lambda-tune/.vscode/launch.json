{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "A. Debug toàn bộ: 3.1 → 3.2 (sinh 5 cấu hình mới) → 3.3",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/lambdatune/run_lambdatune.py",
      "python": "/Users/phatnguyen/miniconda3/envs/lambdatune_env/bin/python",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "LT_DEBUG": "1",
        "PGHOST": "127.0.0.1",
        "PGPORT": "5432"
      },
      "args": [
        "--configs",
        "./cau_hinh_debug",
        "--out",
        "./ket_qua_debug_A",
        "--system",
        "POSTGRES",
        "--benchmark",
        "tpch",
        "--config_gen",
        "--num-configs",
        "5"
      ],
      "console": "integratedTerminal",
      "justMyCode": true
    },
